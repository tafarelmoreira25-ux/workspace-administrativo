VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON
VITE_ADMIN_EMAIL=tafarel@platino.com

# Apenas para o importador backend. Nunca use esta chave no Vite/frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Configure estes valores somente como segredos da Supabase Edge Function.
# Nunca adicione VITE_ ao nome da chave do Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Conversão fiel de DOCX para PDF pela Supabase Edge Function converter-docx-pdf.
# Cadastre como segredos da função (nunca use VITE_ nestes valores).
# O aplicativo Microsoft Entra deve ter acesso de aplicação ao drive informado.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_DRIVE_ID=

# DataJud/CNJ usa chave publica oficial da propria wiki do CNJ dentro da Edge Function.
# Publique a funcao processual-datajud-sync para consulta emergencial de processos.
